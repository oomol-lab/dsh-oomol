{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "outDir": "./lib/types/client",
    "rootDir": "./src/client",
    "types": ["react"]
  },
  "include": ["src/client/**/*.ts", "src/client/**/*.tsx"]
}
